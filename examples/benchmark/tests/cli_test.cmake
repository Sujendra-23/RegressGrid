file(MAKE_DIRECTORY "${TEST_DIR}")
set(metrics "${TEST_DIR}/metrics.json")
file(REMOVE "${metrics}")
foreach(bad IN ITEMS negative zero overflow unknown missing type backend output)
  if(bad STREQUAL negative)
    set(args --elements -1)
  elseif(bad STREQUAL zero)
    set(args --iterations 0)
  elseif(bad STREQUAL overflow)
    set(args --elements 184467440737095516160)
  elseif(bad STREQUAL unknown)
    set(args --unknown 1)
  elseif(bad STREQUAL missing)
    set(args --elements)
  elseif(bad STREQUAL type)
    set(args --type int)
  elseif(bad STREQUAL backend)
    set(args --backend gpu)
  else()
    set(args --output "${TEST_DIR}/missing/metrics.json" --elements 65537 --iterations 1 --warmup 0)
  endif()
  execute_process(COMMAND "${BENCH}" --output "${metrics}" ${args}
    RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 5)
  if(NOT status STREQUAL "1" OR NOT stderr MATCHES "benchmark:" OR EXISTS "${metrics}")
    string(SUBSTRING "${stderr}" 0 512 stderr)
    message(FATAL_ERROR "Invalid CLI case ${bad}: status=${status}, stderr=${stderr}")
  endif()
endforeach()
if(NOT HAS_CUDA)
  execute_process(COMMAND "${BENCH}" --backend cuda --output "${metrics}"
    RESULT_VARIABLE status ERROR_VARIABLE stderr TIMEOUT 5)
  if(NOT status STREQUAL "1" OR NOT stderr MATCHES "CUDA backend unavailable" OR EXISTS "${metrics}")
    message(FATAL_ERROR "CPU build did not reject CUDA: ${stderr}")
  endif()
endif()
execute_process(COMMAND "${BENCH}" --help RESULT_VARIABLE status OUTPUT_VARIABLE stdout TIMEOUT 5)
if(NOT status STREQUAL "0" OR NOT stdout MATCHES "Usage:")
  message(FATAL_ERROR "Help failed")
endif()
execute_process(COMMAND "${BENCH}" --type double --elements 65537 --warmup 0 --iterations 3 --output "${metrics}"
  RESULT_VARIABLE status ERROR_VARIABLE stderr TIMEOUT 5)
if(NOT status STREQUAL "0")
  message(FATAL_ERROR "Benchmark failed: ${stderr}")
endif()
file(READ "${metrics}" json)
string(JSON count LENGTH "${json}" samples_ms)
string(JSON backend GET "${json}" backend)
string(JSON scalar GET "${json}" type)
string(JSON elements GET "${json}" elements)
string(JSON iterations GET "${json}" iterations)
string(JSON warmup GET "${json}" warmup)
string(JSON unit GET "${json}" throughput_unit)
if(NOT count EQUAL 3 OR NOT backend STREQUAL cpu OR NOT scalar STREQUAL double
   OR NOT elements EQUAL 65537 OR NOT iterations EQUAL 3 OR NOT warmup EQUAL 0
   OR NOT unit STREQUAL "elements/s")
  message(FATAL_ERROR "Incorrect metrics: ${json}")
endif()
foreach(field IN ITEMS latency_ms throughput min_ms p95_ms)
  string(JSON value GET "${json}" "${field}")
  if(NOT value GREATER 0)
    message(FATAL_ERROR "Invalid ${field}: ${value}")
  endif()
endforeach()
